# Sólo valores públicos/no secretos para el navegador.
# Vacío = mismo origen. En desarrollo Vite proxifica /v1, /health, /ready y /bootstrap a 127.0.0.1:8787.
VITE_API_BASE_URL=
VITE_APP_ENV=development

# Exclusivamente desarrollo LOCAL. El frontend sólo debe enviarlo en build DEV y el backend
# lo acepta únicamente cuando APP_ENV=development Y la petición llega por localhost/127.0.0.1/::1.
# Un Worker remoto exige Cf-Access-Jwt-Assertion aunque APP_ENV esté mal configurado como development.
VITE_DEV_USER_EMAIL=admin@example.com

# Configurar con la URL pública real del employee-portal en cada entorno.
# No se asume una ruta por defecto para evitar redirecciones rotas.
VITE_EMPLOYEE_PORTAL_URL=
