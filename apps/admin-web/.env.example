# Sólo valores públicos/no secretos para el navegador.
# Vacío = mismo origen. En desarrollo Vite ya proxifica /v1, /health, /ready y /bootstrap a 127.0.0.1:8787.
VITE_API_BASE_URL=
VITE_APP_ENV=development

# Exclusivamente desarrollo local. El backend ignora este header fuera de APP_ENV=development.
VITE_DEV_USER_EMAIL=admin@example.com

# Ruta o URL pública del portal de trabajador.
VITE_EMPLOYEE_PORTAL_URL=/employee/
