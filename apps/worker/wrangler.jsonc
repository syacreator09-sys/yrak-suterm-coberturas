{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "yrak-suterm-coberturas",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "development",
    "APP_ORIGIN": "http://localhost:8787",
    "EMAIL_FROM": "notificaciones@example.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yrak_suterm_coberturas",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "yrak-suterm-evidence"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "PROCESSING_QUEUE", "queue": "yrak-suterm-processing" }
    ],
    "consumers": [
      { "queue": "yrak-suterm-processing", "max_batch_size": 5, "max_batch_timeout": 10 }
    ]
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "GROUP_COORDINATOR", "class_name": "GroupCoordinator" }
    ]
  },
  "exports": {
    "GroupCoordinator": { "type": "durable-object", "storage": "sqlite" }
  },
  "workflows": [
    {
      "name": "yrak-coverage-workflow",
      "binding": "COVERAGE_WORKFLOW",
      "class_name": "CoverageWorkflow"
    }
  ],
  "send_email": [{ "name": "EMAIL" }],
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "yrak-suterm-coberturas-staging",
      "vars": { "ENVIRONMENT": "staging" },
      "durable_objects": {
        "bindings": [
          { "name": "GROUP_COORDINATOR", "class_name": "GroupCoordinator" }
        ]
      }
    },
    "production": {
      "name": "yrak-suterm-coberturas-production",
      "vars": { "ENVIRONMENT": "production" },
      "durable_objects": {
        "bindings": [
          { "name": "GROUP_COORDINATOR", "class_name": "GroupCoordinator" }
        ]
      }
    }
  }
}
